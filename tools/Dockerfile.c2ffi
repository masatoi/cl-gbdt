# Build c2ffi pinned to LLVM 18 so that the same input always yields the same spec,
# independent of whatever LLVM happens to be installed on the host.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
        llvm-18-dev \
        libclang-18-dev \
        clang-18 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch llvm-18.1.0 https://github.com/rpav/c2ffi /src/c2ffi \
    && cmake -S /src/c2ffi -B /src/c2ffi/build \
             -DCMAKE_BUILD_TYPE=Release \
             -DLLVM_DIR=/usr/lib/llvm-18/lib/cmake/llvm \
             -DClang_DIR=/usr/lib/llvm-18/lib/cmake/clang \
    && cmake --build /src/c2ffi/build -j"$(nproc)" \
    && cp /src/c2ffi/build/bin/c2ffi /usr/local/bin/c2ffi \
    && rm -rf /src/c2ffi

ENTRYPOINT ["c2ffi"]
