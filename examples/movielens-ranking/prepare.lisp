(in-package #:cl-user)

(load (merge-pathnames "../common.lisp" *load-truename*))
(in-package #:cl-gbdt-examples)

(load (merge-pathnames "../ranking-state.lisp" *load-truename*))

(defvar *movie-root* nil "The MovieLens example directory for this preparation.")

(defstruct movie-rating user item relevance time)

(defun read-movie-users (path)
  (let ((users (make-hash-table)) (ids nil))
    (with-open-file (in path :external-format :latin-1)
      (loop for line = (read-line in nil nil) while line
            for fields = (split-fields line #\|)
            for id = (parse-integer (first fields))
            do (when (gethash id users) (error "Duplicate user ~D" id))
               (setf (gethash id users)
                     (vector (parse-integer (second fields))
                             (if (string= (third fields) "M") 1 0)))
               (push id ids)))
    (values users (coerce (sort ids #'<) 'vector))))

(defun read-movie-items (path)
  (let ((items (make-hash-table)) (years nil))
    (with-open-file (in path :external-format :latin-1)
      (loop for line = (read-line in nil nil) while line
            for fields = (split-fields line #\|)
            for id = (parse-integer (first fields))
            for date = (third fields)
            for year = (and (>= (length date) 4)
                            (parse-integer date :start (- (length date) 4) :junk-allowed t))
            for genres = (map 'vector #'parse-integer (subseq fields 5 24))
            do (when (gethash id items) (error "Duplicate item ~D" id))
               (when year (push year years))
               (setf (gethash id items) (cons year genres))))
    (let ((median (nth (floor (length years) 2) (sort years #'<))))
      (maphash (lambda (key value) (declare (ignore key))
                 (unless (car value) (setf (car value) median)))
               items))
    items))

(defun movie-row-less-p (a b)
  (or (< (movie-rating-user a) (movie-rating-user b))
      (and (= (movie-rating-user a) (movie-rating-user b))
           (or (< (movie-rating-time a) (movie-rating-time b))
               (and (= (movie-rating-time a) (movie-rating-time b))
                    (< (movie-rating-item a) (movie-rating-item b)))))))

(defun read-movie-ratings (path users items)
  (let ((rows (make-array 0 :adjustable t :fill-pointer 0)))
    (with-open-file (in path)
      (loop for line = (read-line in nil nil) while line
            for fields = (split-fields line #\Tab)
            do (unless (= (length fields) 4) (error "Malformed movie rating"))
               (let ((user (parse-integer (first fields)))
                      (item (parse-integer (second fields)))
                      (rating (parse-integer (third fields)))
                      (time (parse-integer (fourth fields))))
                 (unless (and (gethash user users) (gethash item items) (<= 1 rating 5))
                   (error "Unknown user/item or invalid rating"))
                 (vector-push-extend
                  (make-movie-rating :user user :item item :relevance (1- rating) :time time)
                  rows))))
    (stable-sort rows #'movie-row-less-p)))

(defun write-movie-partition (name rows users items means global)
  (let ((data (merge-pathnames "data/" *movie-root*))
        (groups nil) (current nil) (count 0))
    (with-open-file (x (merge-pathnames (format nil "~A-x.f32" name) data)
                       :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
      (with-open-file (y (merge-pathnames (format nil "~A-y.f32" name) data)
                         :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
        (loop for row across rows
              for user = (movie-rating-user row)
              for user-values = (gethash user users)
              for item-values = (gethash (movie-rating-item row) items)
              do (unless (eql user current)
                   (when current (push count groups))
                   (setf current user count 0))
                 (incf count)
                 (write-f32 x (aref user-values 0))
                 (write-f32 x (aref user-values 1))
                 (write-f32 x (car item-values))
                 (loop for genre across (cdr item-values) do (write-f32 x genre))
                 (write-f32 y (movie-rating-relevance row)))))
    (when current (push count groups))
    (setf groups (nreverse groups))
    (write-groups (merge-pathnames (format nil "~A-groups.lisp" name) data) groups)
    (when (string= name "test")
      (with-open-file (out (merge-pathnames "test-meta.csv" data)
                           :direction :output :if-exists :supersede)
        (format out "user,item,relevance,baseline~%")
        (loop for row across rows
              for pair = (gethash (movie-rating-item row) means)
              for baseline = (if pair (/ (car pair) (cdr pair) 1d0) global)
              do (format out "~D,~D,~D,~,12F~%" (movie-rating-user row)
                         (movie-rating-item row) (movie-rating-relevance row) baseline))))
    (format t "~A: users=~D rows=~D~%" name (length groups) (length rows))))

(defun prepare-movie ()
  (let ((*movie-root* (cl-gbdt-example-lifecycle:example-root *movie-root*)))
    (call-with-ranking-preparation
     *movie-root*
     (lambda ()
       (let ((raw (merge-pathnames "data/ml-100k/" *movie-root*)))
         (multiple-value-bind (users ids) (read-movie-users (merge-pathnames "u.user" raw))
           (let* ((items (read-movie-items (merge-pathnames "u.item" raw)))
                  (rows (read-movie-ratings (merge-pathnames "u.data" raw) users items))
                  (assign (make-hash-table))
                  (means (make-hash-table))
                  (sum 0) (n 0)
                  (parts (loop repeat 3 collect (make-array 0 :adjustable t :fill-pointer 0))))
             (multiple-value-bind (tr va te) (split-indexes (length ids) 42)
               (loop for ix across tr do (setf (gethash (aref ids ix) assign) 0))
               (loop for ix across va do (setf (gethash (aref ids ix) assign) 1))
               (loop for ix across te do (setf (gethash (aref ids ix) assign) 2)))
             (loop for row across rows
                   for split = (gethash (movie-rating-user row) assign)
                   do (vector-push-extend row (nth split parts))
                      (when (zerop split)
                        (let* ((item (movie-rating-item row))
                               (pair (or (gethash item means)
                                         (setf (gethash item means) (cons 0 0)))))
                          (incf (car pair) (movie-rating-relevance row))
                          (incf (cdr pair))
                          (incf sum (movie-rating-relevance row))
                          (incf n))))
             (loop for name in '("train" "valid" "test") for part in parts
                   do (write-movie-partition name part users items means (/ sum n 1d0)))
             (list :train (length (first parts)) :valid (length (second parts))
                   :test (length (third parts)) :features 22)))))
     :name "MovieLens" :prefix "movielens")))

(let ((*movie-root* (uiop:pathname-directory-pathname *load-truename*)))
  (prepare-movie))
