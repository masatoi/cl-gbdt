(in-package #:cl-user)

(load (merge-pathnames "../common.lisp" *load-truename*))

(load (merge-pathnames "../lifecycle.lisp" *load-truename*))

(in-package #:cl-gbdt-examples)

(defun evaluate-power (root)
  (cl-gbdt-example-lifecycle:with-evaluation (root)
    (let ((current (make-array 0 :adjustable t :fill-pointer 0))
          (labels (make-array 0 :adjustable t :fill-pointer 0)))
      (with-open-file (in (merge-pathnames "data/test-meta.csv" root))
        (unless (equal (read-csv-row in) '("now" "target")) (error "Bad power metadata"))
        (loop for row = (read-csv-row in) while row
              do (vector-push-extend (parse-number (first row)) current)
                 (vector-push-extend (parse-number (second row)) labels)))
      (dolist (name '("persistence" "lightgbm" "xgboost" "lightgbm-custom" "xgboost-custom"))
        (let ((path (merge-pathnames (format nil "output/~A-test.csv" name) root)))
          (when (or (member name '("persistence" "lightgbm" "xgboost") :test #'string=)
                    (cl-gbdt-example-lifecycle:custom-current-p root))
            (let ((pred (if (string= name "persistence") current (read-scores path)))
                  (absolute 0d0) (square 0d0) (weighted 0d0)
                  (weights 0d0) (under 0d0) (peaks 0))
              (unless (= (length labels) (length pred)) (error "Wrong score count for ~A" name))
              (dotimes (i (length labels))
                (let* ((error (- (aref pred i) (aref labels i)))
                       (peak (>= (aref labels i) 2d0))
                       (weight (if peak 3d0 1d0)))
                  (incf absolute (abs error))
                  (incf square (* error error))
                  (incf weighted (* weight (abs error)))
                  (incf weights weight)
                  (when peak (incf peaks) (decf under error))))
              (unless (plusp peaks) (error "No peak observations"))
              (format t "~A: mae=~,5F rmse=~,5F weighted_mae=~,5F peak_mean_underprediction=~,5F~%"
                      name (/ absolute (length labels)) (sqrt (/ square (length labels)))
                      (/ weighted weights) (/ under peaks))
              (when (string= name "persistence")
                (format t "test rows=~D peaks=~D (target >= 2kW)~%" (length labels) peaks)))))))))

(evaluate-power (uiop:pathname-directory-pathname *load-truename*))
