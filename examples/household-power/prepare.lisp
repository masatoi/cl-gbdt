(in-package #:cl-user)

(load (merge-pathnames "../common.lisp" *load-truename*))
(in-package #:cl-gbdt-examples)

(defparameter *power-root* (uiop:pathname-directory-pathname *load-truename*))

(defun power-time (date time)
  (let ((d (mapcar #'parse-integer (split-fields date #\/)))
        (h (mapcar #'parse-integer (split-fields time #\:))))
    (unless (and (= (length d) 3) (= (length h) 3)) (error "Invalid date/time"))
    (encode-universal-time (third h) (second h) (first h)
                           (first d) (second d) (third d) 0)))

(defun read-power-series (path)
  (let ((values (make-array 0 :element-type 'single-float :adjustable t :fill-pointer 0))
        (missing (make-array 0 :element-type 'bit :adjustable t :fill-pointer 0))
        (start nil) (previous nil) (raw-count 0))
    (with-open-file (in path)
      (unless (equal (subseq (split-fields (read-line in) #\;) 0 3)
                     '("Date" "Time" "Global_active_power"))
        (error "Unexpected household power columns"))
      (loop for line = (read-line in nil nil) while line
            for fields = (split-fields line #\;)
            for time = (power-time (first fields) (second fields))
            for raw = (third fields)
            do (unless (zerop (mod time 60)) (error "Timestamp is not minute-aligned"))
               (unless start (setf start time))
               (when (and previous (<= time previous))
                 (error "Timestamps are not strictly increasing"))
               (loop while (and previous (> time (+ previous 60)))
                     do (vector-push-extend 0f0 values)
                        (vector-push-extend 1 missing)
                        (incf previous 60))
               (if (string= raw "?")
                   (progn (vector-push-extend 0f0 values)
                          (vector-push-extend 1 missing))
                   (let ((number (parse-number raw)))
                     (unless (finite-real-p number) (error "Invalid power value"))
                     (vector-push-extend (coerce number 'single-float) values)
                     (vector-push-extend 0 missing)))
               (setf previous time)
               (incf raw-count)))
    (values values missing start raw-count)))

(defun open-power-binary (data name)
  (open (merge-pathnames name data) :direction :output :if-exists :supersede
                                    :if-does-not-exist :create
                                    :element-type '(unsigned-byte 8)))

(defun prepare-power ()
  (ensure-example-directories *power-root*)
  (let ((data (merge-pathnames "data/" *power-root*)))
    (multiple-value-bind (values missing start raw-count)
        (read-power-series (merge-pathnames "household_power_consumption.txt" data))
      (let* ((n (length values))
             (cut1 (floor (* n 0.7d0))) (cut2 (floor (* n 0.85d0)))
             (counts (make-array 3 :initial-element 0))
             (sums (make-array 2 :initial-element 0d0))
             (gaps (make-array 2 :initial-element 0))
             (windows #(60 1440))
             (x-streams (make-array 3 :initial-element nil))
             (y-streams (make-array 3 :initial-element nil))
             (mini-x nil) (mini-y nil) (meta nil))
        (unwind-protect
             (progn
               (loop for name in '("train" "valid" "test") for i from 0
                     do (setf (aref x-streams i)
                              (open-power-binary data (format nil "~A-x.f32" name))
                              (aref y-streams i)
                              (open-power-binary data (format nil "~A-y.f32" name))))
               (setf mini-x (open-power-binary data "mini-x.f32")
                     mini-y (open-power-binary data "mini-y.f32")
                     meta (open (merge-pathnames "test-meta.csv" data) :direction :output
                                :if-exists :supersede))
               (format meta "now,target~%")
               (loop for i below n
                     do (dotimes (w 2)
                          (let ((window (aref windows w)))
                            (incf (aref sums w) (aref values i))
                            (incf (aref gaps w) (aref missing i))
                            (when (>= i window)
                              (decf (aref sums w) (aref values (- i window)))
                              (decf (aref gaps w) (aref missing (- i window))))))
                        (when (and (>= i 1440) (< (+ i 60) n)
                                   (zerop (aref gaps 0)) (zerop (aref gaps 1))
                                   (zerop (aref missing (1- i)))
                                   (zerop (aref missing (- i 60)))
                                   (zerop (aref missing (- i 1440)))
                                   (zerop (aref missing (+ i 60))))
                          (let* ((split (cond ((< i (- cut1 60)) 0)
                                              ((and (>= i cut1) (< i (- cut2 60))) 1)
                                              ((>= i cut2) 2)
                                              (t nil))))
                            (when split
                              (let* ((time (+ start (* i 60)))
                                     (minute-of-day (mod (floor time 60) 1440))
                                     (weekday (nth-value 6 (decode-universal-time time 0)))
                                     (features (list (aref values i) (aref values (1- i))
                                                     (aref values (- i 60))
                                                     (aref values (- i 1440))
                                                     (/ (aref sums 0) 60d0)
                                                     (/ (aref sums 1) 1440d0)
                                                     (/ minute-of-day 60d0) weekday))
                                     (target (aref values (+ i 60))))
                                (dolist (feature features)
                                  (write-f32 (aref x-streams split) feature))
                                (write-f32 (aref y-streams split) target)
                                (when (and (zerop split) (< (aref counts 0) 100000))
                                  (dolist (feature features) (write-f32 mini-x feature))
                                  (write-f32 mini-y target))
                                (when (= split 2)
                                  (format meta "~,8F,~,8F~%" (aref values i) target))
                                (incf (aref counts split)))))))
               (unless (every #'plusp counts) (error "An evaluation partition is empty"))
               (write-sizes (merge-pathnames "sizes.lisp" data)
                            :train (aref counts 0) :valid (aref counts 1) :test (aref counts 2)
                            :features 8 :mini (min 100000 (aref counts 0)))
               (format t "raw=~D resampled=~D train=~D valid=~D test=~D~%"
                       raw-count n (aref counts 0) (aref counts 1) (aref counts 2)))
          (loop for stream across x-streams when stream do (close stream))
          (loop for stream across y-streams when stream do (close stream))
          (when mini-x (close mini-x)) (when mini-y (close mini-y))
          (when meta (close meta)))))))

(prepare-power)
