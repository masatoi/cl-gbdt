(in-package #:cl-user)

(load (merge-pathnames "../common.lisp" *load-truename*))
(in-package #:cl-gbdt-examples)

(load (merge-pathnames "state.lisp" *load-truename*))

(defvar *mslr-root* nil "The MSLR example directory for this preparation.")

(defstruct mslr-row qid label features)

(defun read-mslr (path split query-owner)
  (let ((rows (make-array 0 :adjustable t :fill-pointer 0)))
    (with-open-file (in path)
      (loop for line = (read-line in nil nil) while line
            for useful = (subseq line 0 (position #\# line))
            for parts = (remove "" (split-fields (substitute #\Space #\Tab useful) #\Space)
                                :test #'string=)
            unless (null parts)
              do (let ((label (parse-number (first parts)))
                        (features (make-array 136 :element-type 'single-float :initial-element 0f0))
                        (seen (make-hash-table))
                        (qid nil))
                   (unless (and (integerp label) (<= 0 label 4))
                     (error "Invalid relevance in ~A: ~A" path label))
                   (dolist (field (rest parts))
                     (let ((colon (position #\: field)))
                       (unless colon (error "Invalid field ~S" field))
                       (let ((key (subseq field 0 colon)) (value (subseq field (1+ colon))))
                         (if (string= key "qid")
                             (progn
                               (when qid (error "Repeated query ID"))
                               (setf qid (parse-integer value))
                               (when (minusp qid) (error "Negative query ID")))
                             (let ((index (parse-integer key)) (number (parse-number value)))
                               (unless (and (<= 1 index 136) (finite-real-p number)
                                            (not (gethash index seen)))
                                 (error "Invalid or repeated feature ~S" field))
                               (setf (gethash index seen) t
                                     (aref features (1- index)) (coerce number 'single-float)))))))
                   (unless qid (error "Missing query ID in ~A" path))
                   (let ((owner (gethash qid query-owner)))
                     (when (and owner (not (eq owner split)))
                       (error "Query ~D occurs in both ~A and ~A" qid owner split))
                     (setf (gethash qid query-owner) split))
                   (vector-push-extend (make-mslr-row :qid qid :label label :features features)
                                       rows))))
    (when (zerop (length rows)) (error "Empty ranking split: ~A" path))
    (stable-sort rows #'< :key #'mslr-row-qid)))

(defun write-mslr (split rows)
  (let ((data (merge-pathnames "data/" *mslr-root*)) (groups nil) (current nil) (count 0))
    (with-open-file (x (merge-pathnames (format nil "~(~A~)-x.f32" split) data)
                       :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
      (with-open-file (y (merge-pathnames (format nil "~(~A~)-y.f32" split) data)
                         :direction :output :if-exists :supersede
                         :element-type '(unsigned-byte 8))
        (loop for row across rows
              do (unless (eql current (mslr-row-qid row))
                   (when current (push count groups))
                   (setf current (mslr-row-qid row) count 0))
                 (incf count)
                 (loop for value across (mslr-row-features row) do (write-f32 x value))
                 (write-f32 y (mslr-row-label row)))))
    (push count groups)
    (write-groups (merge-pathnames (format nil "~(~A~)-groups.lisp" split) data)
                  (nreverse groups))
    (when (eq split :test)
      (with-open-file (out (merge-pathnames "test-meta.csv" data)
                           :direction :output :if-exists :supersede)
        (format out "qid,relevance~%")
        (loop for row across rows
              do (format out "~D,~D~%" (mslr-row-qid row) (mslr-row-label row)))))
    (format t "~(~A~): rows=~D~%" split (length rows))))

(defun prepare-mslr ()
  (let ((*mslr-root* (cl-gbdt-example-lifecycle:example-root *mslr-root*)))
    (call-with-ranking-preparation
     *mslr-root*
     (lambda ()
       (let* ((fold (or (uiop:getenv "CL_GBDT_MSLR_FOLD")
                        (error "Set CL_GBDT_MSLR_FOLD to the extracted fold directory")))
              ;; An environment variable holds an operating-system file name.
              (directory (uiop:parse-native-namestring fold :ensure-directory t))
              (owners (make-hash-table))
              (counts nil))
         (dolist (entry '((:train . "train.txt") (:valid . "vali.txt") (:test . "test.txt")))
           (let ((rows (read-mslr (merge-pathnames (cdr entry) directory) (car entry) owners)))
             (write-mslr (car entry) rows)
             (setf counts (append counts (list (car entry) (length rows))))))
         (append counts (list :features 136))))
     :name "MSLR" :prefix "mslr")))

(let ((*mslr-root* (uiop:pathname-directory-pathname *load-truename*)))
  (prepare-mslr))
